{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "prepare": "svelte-kit sync",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.js --external:electron --external:ffmpeg-static --format=esm && esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --external:electron --format=cjs",
    "build": "svelte-kit sync && vite build && pnpm run build:electron",
    "dev:renderer": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "dev:bundle-main": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.js --external:electron --external:ffmpeg-static --format=esm --watch",
    "dev:bundle-preload": "esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --external:electron --format=cjs --watch",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "svelte-kit sync && pnpm run build:electron && concurrently -k -n renderer,main,preload,app -c cyan,magenta,green,yellow \"pnpm run dev:renderer\" \"pnpm run dev:bundle-main\" \"pnpm run dev:bundle-preload\" \"pnpm run dev:electron\"",
    "lint": "eslint src electron",
    "typecheck": "svelte-kit sync && svelte-check --fail-on-warnings && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@lfc/ffmpeg-core": "workspace:*",
    "@lfc/validators": "workspace:*",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@lfc/config": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24.10.7",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "esbuild": "^0.27.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.3",
    "svelte": "^5.46.1",
    "svelte-check": "^4.4.1",
    "typescript": "~5.7.3",
    "vite": "^8.0.0",
    "wait-on": "^9.0.3"
  }
}
