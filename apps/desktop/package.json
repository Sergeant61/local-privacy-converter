{
  "name": "desktop",
  "version": "1.4.0",
  "description": "Local Privacy Converter — offline media conversion desktop app",
  "author": {
    "name": "Recep Özen",
    "email": "sergeant61@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sergeant61/local-privacy-converter.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "prepare": "svelte-kit sync",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.js --external:electron --format=esm && esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --external:electron --format=cjs",
    "build": "svelte-kit sync && vite build && node scripts/patch-build-for-file-url.mjs && pnpm run build:electron",
    "dev:renderer": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "dev:bundle-main": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.js --external:electron --format=esm --watch",
    "dev:bundle-preload": "esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --external:electron --format=cjs --watch",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "node ../../scripts/prepare-ffmpeg.mjs && svelte-kit sync && pnpm run build:electron && concurrently -k -n renderer,main,preload,app -c cyan,magenta,green,yellow \"pnpm run dev:renderer\" \"pnpm run dev:bundle-main\" \"pnpm run dev:bundle-preload\" \"pnpm run dev:electron\"",
    "lint": "eslint src electron",
    "typecheck": "svelte-kit sync && svelte-check --fail-on-warnings && tsc --noEmit -p tsconfig.electron.json",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "test": "vitest run"
  },
  "dependencies": {
    "@lfc/ffmpeg-core": "workspace:*",
    "@lfc/media-formats": "workspace:*",
    "@lfc/types": "workspace:*",
    "@lfc/validators": "workspace:*",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@lfc/config": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24.10.7",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.3",
    "svelte": "^5.46.1",
    "svelte-check": "^4.4.1",
    "typescript": "~5.7.3",
    "vite": "^8.0.0",
    "wait-on": "^9.0.3"
  }
}
